<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_open_balance_sheet" model="ir.actions.server">
        <field name="name">Balance Sheet</field>
        <field name="model_id" ref="account.model_account_report"/>
        <field name="state">code</field>
        <field name="code">action = env['fin.report.viewer'].action_open_report('fin_reports_generic.balance_sheet')</field>
    </record>
    <record id="action_open_profit_and_loss" model="ir.actions.server">
        <field name="name">Profit and Loss</field>
        <field name="model_id" ref="account.model_account_report"/>
        <field name="state">code</field>
        <field name="code">action = env['fin.report.viewer'].action_open_report('fin_reports_generic.profit_and_loss')</field>
    </record>
    <record id="action_open_cash_flow" model="ir.actions.server">
        <field name="name">Cash Flow Statement</field>
        <field name="model_id" ref="account.model_account_report"/>
        <field name="state">code</field>
        <field name="code">action = env['fin.report.viewer'].action_open_report('fin_reports_generic.cash_flow')</field>
    </record>

    <menuitem id="menu_balance_sheet"
              name="Balance Sheet"
              parent="account.account_reports_legal_statements_menu"
              action="action_open_balance_sheet"
              sequence="1"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_profit_and_loss"
              name="Profit and Loss"
              parent="account.account_reports_legal_statements_menu"
              action="action_open_profit_and_loss"
              sequence="2"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <menuitem id="menu_cash_flow"
              name="Cash Flow Statement"
              parent="account.account_reports_legal_statements_menu"
              action="action_open_cash_flow"
              sequence="3"
              groups="account.group_account_readonly,account.group_account_basic"/>
</odoo>
